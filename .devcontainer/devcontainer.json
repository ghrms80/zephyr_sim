{
  "name": "Zephyr 4.4 Dev",
  "build": {
    "dockerfile": "Dockerfile",
    "context": ".." 
  },
  "remoteUser": "user",
  "remoteEnv": {
    "LC_ALL": "C",
    "ZEPHYR_TOOLCHAIN_VARIANT": "zephyr",
    "ZEPHYR_BASE": "/workspaces/zephyr_sim/zephyr"
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-vscode.cpptools",
        "ms-vscode.cmake-tools",
        "trond-snekvik.devicetree"
      ]
    }
  },
  // 컨테이너 생성 후 setup.sh를 실행하도록 설정
  "postCreateCommand": "bash .devcontainer/setup.sh"
}
