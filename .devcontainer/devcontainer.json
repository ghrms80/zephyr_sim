{
  "name": "Zephyr 4.4 Dev",
  "image": "zephyrprojectrtos/ci:v0.28.0",
  "remoteEnv": {
    "LC_ALL": "C",
    "ZEPHYR_TOOLCHAIN_VARIANT": "zephyr"
  },
  "onCreateCommand": "bash .devcontainer/setup.sh",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-vscode.cpptools",
        "ms-vscode.cmake-tools"
      ]
    }
  }
}
