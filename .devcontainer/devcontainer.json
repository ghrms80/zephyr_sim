{
  "name": "Zephyr 4.4 Dev",
  "image": "ghcr.io/ghrms80/zephyr-sim:latest",
  "remoteUser": "user",
  "remoteEnv": {
    "LC_ALL": "C",
    "ZEPHYR_TOOLCHAIN_VARIANT": "zephyr"
  },
  "onCreateCommand": "bash /workspaces/zephyr_sim/.devcontainer/setup.sh",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-vscode.cpptools",
        "ms-vscode.cmake-tools"
      ]
    }
  }
}
